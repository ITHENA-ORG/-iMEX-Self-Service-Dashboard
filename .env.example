# Fill these yourself. Never commit .env.
TB_URL=https://demo.thingsboard.io
TB_TENANT_USERNAME=
TB_TENANT_PASSWORD=
TB_MQTT_HOST=demo.thingsboard.io
TB_MQTT_PORT=1883
SESSION_SECRET=<random string>
SERVICE_PORT=4000
# No LLM key here (D-070, App UI U-097): the one AI key lives on the tenant-only asset DBBLLM-CONFIG
# (dbb_llm_api_key), entered by a tenant admin on Configuration › General › AI (LLM) usage.
# Delay between ThingsBoard REST calls in ms (shared demo server is rate limited)
TB_MIN_DELAY_MS=150

# ---- TARGET for the server migration (the NEW tenant on iserv-demov2; the SRC_TB_* tenant above stays read-only)
# Fill these in; the migration scripts write only here.
TGT_TB_URL=https://iserv-demov2.ithena.app/
TGT_TB_USERNAME=
TGT_TB_PASSWORD=
# minimum gap between requests to the server, in ms (the server throttles; 150 is what SRC uses)
TGT_TB_MIN_DELAY_MS=150
# initial password for the users the migration creates on the new tenant (no activation e-mails are sent)
TGT_USER_PASSWORD=

